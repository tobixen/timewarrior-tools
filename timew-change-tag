#!/usr/bin/env python3
"""Change tags in timewarrior intervals.

Can replace single tags or transform combinations of tags.

Examples:
    # Simple: change 'oldtag' to 'newtag'
    timew-change-tag oldtag newtag

    # With timespan
    timew-change-tag oldtag newtag --from 2026-01-01

    # Transform tag combination: intervals with 'transport' AND '~aw' -> '4ME,transport'
    timew-change-tag 'transport,~aw' '4ME,transport'

    # Dry run - show what would change
    timew-change-tag oldtag newtag --dry-run

    # Remove a tag (empty replacement)
    timew-change-tag unwanted-tag ''
"""

import argparse
import json
import subprocess
import sys
from datetime import datetime, timedelta


def parse_tags(tag_string: str) -> set[str]:
    """Parse comma-separated tags into a set."""
    if not tag_string:
        return set()
    return {t.strip() for t in tag_string.split(",") if t.strip()}


def get_intervals(timespan: str | None = None) -> list[dict]:
    """Get intervals from timew export."""
    cmd = ["timew", "export"]
    if timespan:
        cmd.extend(timespan.split())

    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error running timew export: {result.stderr}", file=sys.stderr)
        sys.exit(1)

    return json.loads(result.stdout) if result.stdout.strip() else []


def find_matching_intervals(intervals: list[dict], match_tags: set[str]) -> list[dict]:
    """Find intervals that contain ALL the match_tags."""
    matching = []
    for interval in intervals:
        interval_tags = set(interval.get("tags", []))
        if match_tags.issubset(interval_tags):
            matching.append(interval)
    return matching


TIMEW_STAMP = "%Y%m%dT%H%M%SZ"


def resolve_interval(start: str) -> dict | None:
    """Look up an interval by its immutable start timestamp, with a fresh @id.

    Timewarrior assigns @ids backwards from the newest interval, so *any* interval
    created while we work - in practice by the aw-export-timewarrior sync daemon -
    shifts every id.  Ids must therefore be re-read immediately before each
    mutation rather than collected once up front, or we retag the neighbours.
    """
    try:
        stamp = datetime.strptime(start, TIMEW_STAMP)
    except ValueError:
        return None

    lo = (stamp - timedelta(seconds=1)).strftime(TIMEW_STAMP)
    hi = (stamp + timedelta(seconds=1)).strftime(TIMEW_STAMP)

    # A ranged export still reports global @ids, but returns everything that
    # *overlaps* the range - so match the start exactly.
    for interval in get_intervals(f"{lo} - {hi}"):
        if interval.get("start") == start and interval.get("id") is not None:
            return interval
    return None


def _satisfied(verb: str, interval: dict, tags: set[str]) -> bool:
    """Has `verb` already taken effect on this interval?"""
    present = set(interval.get("tags", []))
    return not (tags & present) if verb == "untag" else tags.issubset(present)


def run_timew(
    verb: str, start: str, tags: set[str], expect: set[str], dry_run: bool, attempts: int = 3
) -> bool:
    """Re-resolve `start` to a current @id and apply one timew verb to it.

    The id is re-read immediately before the mutation and the result is verified
    afterwards.  A concurrent write landing inside that narrow window would send
    the mutation to the wrong interval, so an unverified result is retried.
    """
    for attempt in range(attempts):
        interval = resolve_interval(start)
        if interval is None:
            print(f"  Error: interval starting {start} vanished; skipping", file=sys.stderr)
            return False

        if _satisfied(verb, interval, tags):
            return True

        # Belt and braces: never mutate an interval that lost the tags we matched on.
        if not expect.issubset(set(interval.get("tags", []))):
            print(
                f"  Error: interval starting {start} no longer carries "
                f"{', '.join(sorted(expect))}; skipping",
                file=sys.stderr,
            )
            return False

        cmd = ["timew", verb, f"@{interval['id']}"] + sorted(tags)
        if dry_run:
            print(f"  Would run: {' '.join(cmd)}")
            return True

        result = subprocess.run(cmd, capture_output=True, text=True)
        if result.returncode != 0:
            print(f"  Error {verb}: {result.stderr}", file=sys.stderr)
            return False

        after = resolve_interval(start)
        if after is not None and _satisfied(verb, after, tags):
            return True

        if attempt < attempts - 1:
            print(
                f"  Warning: {verb} on {start} did not take effect "
                f"(concurrent write?); retrying",
                file=sys.stderr,
            )

    print(f"  Error: {verb} on {start} could not be verified; giving up", file=sys.stderr)
    return False


def change_tags(
    start: str,
    remove_tags: set[str],
    add_tags: set[str],
    match_tags: set[str],
    dry_run: bool,
) -> bool:
    """Change tags on the interval starting at `start`. Returns True if successful.

    Adding comes first: if either step fails, the interval is left carrying
    both the old and the new tags rather than neither, still matches, and a
    rerun finishes the job.
    """
    if add_tags and not run_timew("tag", start, add_tags, match_tags, dry_run):
        return False

    # The tag above invalidates the id, so this re-resolves.
    if remove_tags and not run_timew("untag", start, remove_tags, match_tags | add_tags, dry_run):
        return False

    return True


def format_interval(interval: dict) -> str:
    """Format interval for display."""
    start = interval.get("start", "?")
    if isinstance(start, str) and len(start) > 19:
        start = start[:19]  # Trim timezone for display
    tags = ", ".join(sorted(interval.get("tags", [])))
    return f"{start} [{tags}]"


def main():
    parser = argparse.ArgumentParser(
        description="Change tags in timewarrior intervals",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s oldtag newtag                    # Simple tag rename
  %(prog)s oldtag newtag --from 2026-01-01  # With timespan
  %(prog)s 'a,b' 'x,y'                      # Transform: a+b -> x+y
  %(prog)s oldtag ''                        # Remove a tag
  %(prog)s oldtag newtag --dry-run          # Preview changes
        """
    )
    parser.add_argument("from_tags", help="Tag(s) to match/remove (comma-separated)")
    parser.add_argument("to_tags", help="Tag(s) to add (comma-separated, or empty string to just remove)")
    parser.add_argument("--from", dest="from_date", help="Start date for timespan")
    parser.add_argument("--to", dest="to_date", help="End date for timespan")
    parser.add_argument("-n", "--dry-run", action="store_true", help="Show what would be done without making changes")
    parser.add_argument("-v", "--verbose", action="store_true", help="Show each interval being changed")

    args = parser.parse_args()

    # Parse tags
    match_tags = parse_tags(args.from_tags)
    new_tags = parse_tags(args.to_tags)

    if not match_tags:
        print("Error: must specify at least one tag to match", file=sys.stderr)
        sys.exit(1)

    # Build timespan
    timespan = None
    if args.from_date or args.to_date:
        parts = []
        if args.from_date:
            parts.append(args.from_date)
        else:
            parts.append("2020-01-01")
        parts.append("-")
        if args.to_date:
            parts.append(args.to_date)
        else:
            parts.append("tomorrow")
        timespan = " ".join(parts)

    # Get intervals
    intervals = get_intervals(timespan)
    matching = find_matching_intervals(intervals, match_tags)
    # Snapshot for the post-run collateral audit, keyed by immutable start.
    preexisting = {i.get("start"): set(i.get("tags", [])) for i in intervals}

    if not matching:
        print(f"No intervals found with tags: {', '.join(sorted(match_tags))}")
        sys.exit(0)

    # Calculate what tags to add/remove
    # Remove: tags that are in match_tags but not in new_tags
    # Add: tags that are in new_tags but not in match_tags
    tags_to_remove = match_tags - new_tags
    tags_to_add = new_tags - match_tags

    print(f"Found {len(matching)} intervals with tags: {', '.join(sorted(match_tags))}")
    if tags_to_remove:
        print(f"Will remove: {', '.join(sorted(tags_to_remove))}")
    if tags_to_add:
        print(f"Will add: {', '.join(sorted(tags_to_add))}")
    if args.dry_run:
        print("(Dry run - no changes will be made)")
    print()

    # Process intervals
    success_count = 0
    for interval in matching:
        start = interval.get("start")
        if start is None:
            print(f"Warning: interval has no start: {format_interval(interval)}", file=sys.stderr)
            continue

        if args.verbose or args.dry_run:
            print(f"@{interval.get('id')}: {format_interval(interval)}")

        if change_tags(start, tags_to_remove, tags_to_add, match_tags, args.dry_run):
            success_count += 1

    print()
    if args.dry_run:
        print(f"Would change {success_count} intervals")
        return 0

    print(f"Changed {success_count} intervals")

    # Audit: a concurrent write can in principle divert a mutation onto a
    # neighbouring interval.  Report any interval that gained the added tags or
    # lost the removed ones without having been a target, so such damage is
    # never silent.
    intended = {i.get("start") for i in matching}
    gained, lost = [], []
    for i in get_intervals(timespan):
        start = i.get("start")
        if start in intended:
            continue
        now = set(i.get("tags", []))
        before = preexisting.get(start, set())
        if tags_to_add and tags_to_add <= now and not tags_to_add <= before:
            gained.append(i)
        if start in preexisting and (before - now) & tags_to_remove:
            lost.append(i)
    for label, tags, found in (
        ("gained", tags_to_add, gained),
        ("lost", tags_to_remove, lost),
    ):
        if found:
            print(
                f"\nWARNING: {len(found)} interval(s) unexpectedly {label} "
                f"{', '.join(sorted(tags))}:",
                file=sys.stderr,
            )
            for i in found:
                print(f"  @{i.get('id')}: {format_interval(i)}", file=sys.stderr)
    if gained or lost:
        return 1

    return 0 if success_count == len(matching) else 1


if __name__ == "__main__":
    sys.exit(main())
